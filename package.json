{
  "name": "offline-word",
  "version": "1.0.0",
  "description": "OfflineWord - offline Word-style editor (Windows, Android, web)",
  "main": "electron/main.js",
  "author": "OfflineWord contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "android:sync": "cap add android && cap sync android",
    "android:apk": "cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.offlineword.app",
    "productName": "OfflineWord",
    "files": ["electron/**/*", "app/**/*"],
    "icon": "app/icon.png",
    "fileAssociations": [{"ext": "docx", "name": "Word Document", "role": "Editor"}],
    "win": {"target": ["nsis", "portable"]},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true},
    "directories": {"output": "dist"}
  }
}
